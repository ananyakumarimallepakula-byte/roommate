# ========================================================
# ROOMMATE Platform - Backend Environment Template
# Copy this file to .env and adjust credentials as needed
# ========================================================

# Server Port
SERVER_PORT=8080

# Spring Profile (leave empty for local dev, set to "prod" for production)
SPRING_PROFILES_ACTIVE=

# Database Configuration (MySQL — used when profile is 'prod' or 'mysql')
DB_HOST=localhost
DB_PORT=3306
DB_NAME=roommate_db
DB_USER=root
DB_PASSWORD=root

# Flyway Migration Flag (auto-enabled in prod profile)
FLYWAY_ENABLED=false

# File Storage
UPLOAD_DIR=uploads

# Security & Stateless JWT Secret (HMAC-SHA256 / Min 256 bits)
# IMPORTANT: Generate a unique secret for production!
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Data Seeding — set to false in production after initial deploy
DATA_INIT_ENABLED=true
