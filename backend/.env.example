# ========================================================
# ROOMMATE Platform - Backend Environment Template
# Copy this file to .env and adjust credentials as needed
# ========================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=roommate_db
DB_USER=root
DB_PASSWORD=root

# Flyway Migration Flag
FLYWAY_ENABLED=false

# File Storage
UPLOAD_DIR=uploads

# Security & Stateless JWT Secret (HMAC-SHA256 / Min 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
